# Scout Configuration (Not used in app - for documentation only)
# Configure your credentials directly in the Scout app Settings tab
# Never commit your actual API key to version control

# Example Model ID format
MODEL_ID=workspace/version

# Example: my-workspace/3
# Get this from your Roboflow project's model version page

# Roboflow API Key
API_KEY=your_api_key_here

# Get your API key from:
# https://app.roboflow.com/settings/api
